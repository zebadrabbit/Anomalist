PORT=3001
DB_PATH=./anomalist.db
OWNER_TOKEN=change-me
MEDIA_DIR=./media

# Largest accepted upload, in bytes. Default 100 MB.
MEDIA_MAX_BYTES=104857600

# Comma-separated origins allowed to connect. Leave unset to allow any origin;
# socket broadcasts are gated on authentication regardless.
# CORS_ORIGIN=https://overlay.example.com
