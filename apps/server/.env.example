PORT=3001
DB_PATH=./anomalist.db
OWNER_TOKEN=change-me
MEDIA_DIR=./media

# Largest accepted upload, in bytes. Default 100 MB.
MEDIA_MAX_BYTES=104857600

# Comma-separated origins allowed to connect. Leave unset to allow any origin;
# socket broadcasts are gated on authentication regardless.
# CORS_ORIGIN=https://overlay.example.com

# Set this ONLY when Anomalist sits behind a reverse proxy. Without it the login
# rate limiter sees the proxy's address for every request, so ten failed logins
# from anyone lock out everyone. With it set on a directly reachable server the
# opposite breaks: anyone can forge X-Forwarded-For and never be limited.
# Use the number of proxies in front of the server (1 for a single nginx/Caddy),
# or a comma-separated list of trusted addresses. TRUST_PROXY=true is refused at
# startup: it trusts every hop, which is the forgery case above.
# TRUST_PROXY=1
